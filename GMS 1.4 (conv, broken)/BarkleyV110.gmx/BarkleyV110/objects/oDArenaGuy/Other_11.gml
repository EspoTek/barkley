global.dialog=1;
if (sOvar(oIntro22,-1)!=2) {
sCinema(oBarkley,"dialog","Combatant:\\The ghastly doomhell skeleton always gets me in the second round... Not this year. I trained many seasons and meditated to the five arts relentlessly. My time has come.");
} else {
sCinema(oBarkley,"dialog","Combatant:\\I lost to the doomhell skeleton again, but not without a fight. I performed a backheel solar plexus kick with outstanding accuracy and I'm certain his laughing was only to mask his evident pain. Had he not managed to kick and stab me several times I surely would have won with a deadly Palm-Fist Uppercut.");
}
