global.dialog=1;
sCinema(oBarkley,"dialog","The Animayor:\\I have travelled many lands in my attempt to compile a comprehensive guide to all creatures that go bump in the night. Perhaps you could call it a... bestiary. Whatever you call it, my knowledge extends far beyond that of most mortals. Perhaps you would choose to partake of it.");
sCinema(oBarkley,"code",cine_0000);
sCinema(oBarkley,"cond",cine_0001);
sCinema(oBarkley,"dialog","The Animayor:\\I can only hope that my knowledge has aided you in some form or another. It is my goal to make mainstream the information I have given you... Also I have a PhD in anime.");
