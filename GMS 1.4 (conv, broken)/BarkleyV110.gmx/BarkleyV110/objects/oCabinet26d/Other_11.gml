global.dialog=1;
if (sOvar(object_index,-1)=1) {
sCinema(oFollower0,"dialog","I don't think this computer will ever work again. Who knows what deadly b-ball secrets it held?",1);
} else {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Damnit, another broken computer.",1);
sCinema(oFollower3,"dialog","I don't think I can fix this one, dad. The flexdrive's external hypercircuitry has been rerouted beyond repair. If I could get to the CPU access memory I'd be able to encrypt some data nodes, but I don't think we have time for that.",1);
sCinema(oBarkley,"dialog","It's okay, son. You did your best and that's what counts.",1);
}
