global.dialog=1;
if (global.scheme[10]=0) {
global.scheme[10]=1;
sCinema(oHellbane,"dialog","This is the final resting place of Muggsy Bogues, one of the finest point guards in basketball history.",1);
sCinema(oBarkley,"dialog","He was more than just a good point guard... He was a good friend. I-I was responsible for his death. He was one of the first killed in the Great B-Ball Purge. I never got to say goodbye...",1);
sCinema(oBarkley,"wait",1.5);
sCinema(oBarkley,"dialog","Wh-what's this? Did a tear just come from the sarcophagus?",1);
sCinema(oBarkley,"item","BBall Tear",1);
sCinema(oBarkley,"dialog","Th-thank you Muggsy... Thank you.",1);
} else {
sCinema(oBarkley,"dialog","Thank you old friend... Goodbye.",1);
}
