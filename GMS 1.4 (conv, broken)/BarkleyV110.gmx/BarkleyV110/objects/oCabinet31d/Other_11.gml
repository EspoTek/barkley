global.dialog=1;
if (sOvar(object_index,-1)=1) {
sCinema(oBarkley,"dialog","Doctor Davis... zero or hero?",1);
sCinema(oFollower2,"dialog","History will be the judge of that.",1);
} else {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Progress Report : 02/02/2040\\Despite the minor setbacks we've encountered, I am still determined to finish this b-ball. We will, unfortunately, have to reduce the power, which I am still reluctant about, but I believe ultimately this ball will change how the game is played. Furthermore, I believe that the mini Chaos Dunk was caused more by the lack of manufacted slamicite, rather than too much of it. I will be increasing the amount of slamicite by 20% in the upcoming tests.\\-Davis");
sCinema(oFollower0,"dialog","Davis... Davis cannot see past his own foolish desire to create the greatest ball in the world.",1);
sCinema(oFollower2,"dialog","I have been thinking about this Dr. Davis character.",1);
sCinema(oFollower0,"dialog","Yes?",1);
sCinema(oFollower2,"dialog","It is very clear to me that Davis wants to create this ball because of his own shortcomings. He very obviously aspired to be a ball but didn't make the cut; this ball is the manifestation of his own desire to be a b-ball player. It legitimizes his failure at the sport.",1);
sCinema(oBarkley,"dialog","He wanted to be one of the greats, but since he couldn't, he'd do the next best thing. I almost feel kind of bad for him.",1);
}
