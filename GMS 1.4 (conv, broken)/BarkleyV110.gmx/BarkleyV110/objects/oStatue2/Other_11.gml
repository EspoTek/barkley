global.dialog=1;
if (global.scheme[16]=0) {
global.scheme[16]=1;
sCinema(oBarkley,"dialog","What's this? A statue of the Ultimate Ball?",1);
sCinema(oHellbane,"dialog","Yes, Barkley. This statue particuarly interests me because of an incredible power it has.",1);
sCinema(oBarkley,"dialog","P-power... What power is that?",1);
sCinema(oHellbane,"dialog","Touch it, Barkley.",1);
sCinema(oBarkley,"tint",c_white,0.5);
sCinema(oBarkley,"wait",1);
sCinema(oBarkley,"code",cine_0392);
sCinema(oBarkley,"tint",c_white,0);
sCinema(oBarkley,"dialog","A-amazing! I feel my b-ball energy returning to me as we speak! This is incredible!",1);
sCinema(oHellbane,"dialog","Yes, Barkley. This statue restores the b-ball energies to those who touch it. It is quite an amazing artifact, one that I have studied quite extensively and still cannot find an answer to. Although perplexing, though, it seems to have no ill effects. We can use it as we please.",1);
sCinema(oBarkley,"dialog","The ancient ballers... They were... Amazing...",1);
} else {
sCinema(oBarkley,"tint",c_white,0.5);
sCinema(oBarkley,"wait",1);
sCinema(oBarkley,"code",cine_0392);
sCinema(oBarkley,"tint",c_white,0);
sCinema(oBarkley,"dialog","B-ball energies restored!");
}
