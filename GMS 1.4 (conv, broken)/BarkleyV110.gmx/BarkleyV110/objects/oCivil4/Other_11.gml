global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Dave:\\See that door over there? The one that won't open?");
sCinema(oBarkley,"dialog","What about it?",1);
sCinema(oBarkley,"dialog","Dave:\\I heard there's a trick to opening it. Something about a key in Cuchulainn's Tomb? Does that mean anything to you?");
sCinema(oBarkley,"dialog","No.",1);
sCinema(oBarkley,"dialog","Dave:\\Yeah, me neither. Just wondering.");
} else {
sCinema(oBarkley,"dialog","Dave:\\You gotta wonder who locked it in the first place. Dr. Allard, maybe, but I bet you this door is older than him. Probably none of the Cesspool X folks, they've only been around for a few years. Maybe it was Cuchulainn. I don't even know who he is. It's a real mystery, you know?");
sCinema(oBarkley,"dialog","I guess.",1);
}
