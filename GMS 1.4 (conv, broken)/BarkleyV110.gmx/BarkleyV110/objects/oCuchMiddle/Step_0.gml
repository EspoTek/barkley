if (place_meeting(x,y,oBarkley)) {
if (oCuchHoop1.shift=oCuchHoop3.go[oCuchHoop3.progress]) oCuchHoop3.progress+=1;
else oCuchHoop3.progress=0;
if (oCuchHoop3.progress=4) {
sCinema(oBarkley,"effect","fadein",3);
global.roz=RomCuchHoop1;
}
if (oBarkley.x<240) {
with (oBarkley) { y+=480; x+=192; }
} else if (oBarkley.x<400) {
with (oBarkley) { y+=480; }
} else {
with (oBarkley) { y+=480; x-=192; }
}
}
