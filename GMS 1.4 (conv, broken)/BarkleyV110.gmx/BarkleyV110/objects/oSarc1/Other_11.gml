global.dialog=1;
sCinema(oBarkley,"dialog","The sarcophagus... It's... open.",1);
sCinema(oHellbane,"dialog","Yes, Barkley... Ancient b-ball magics haunt these halls, causing the dead to rise.",1);
sCinema(oBarkley,"dialog","Is that a joke? Are you trying to bamboozle me?",1);
sCinema(oHellbane,"dialog","The joke's on you if you choose not to believe me. But forget it, Barkley. You're an old man stuck in your ways. You'll soon see the truth...",1);
sCinema(oBarkley,"dialog","We'll see about that...",1);
