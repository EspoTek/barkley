global.dialog=1;
if (global.scheme[7]=0) {
global.scheme[7]=1;
sCinema(oBarkley,"dialog","Man:\\This parking lot? They say it used to be a basketball court. That must have been a sight. People playing b-ball in public. Pretty wild, huh?");
sCinema(oBarkley,"dialog","You've got no idea. Before the Great B-ball Purge this place would be packed.  Fans on the sidelines, ballers playing pick-up games till dusk. Hell, sometimes they'd have games going until they shut the lights off, even after. It was a different time, a diff...",1);
sCinema(oBarkley,"dialog","Man:\\Whoa pal, I'm gonna stop you right there. I ain't no sportlover, and I don't like where this conversation's headed. There's cops around and you don't know who's listening. Beat it before you say something we're both gonna regret.");
} else {
sCinema(oBarkley,"dialog","Man:\\I thought I told you to beat it. I'm not going to jail 'cause of your sportloving ass.");
}
