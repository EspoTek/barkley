global.dialog=1;
if (global.scheme[14]=0) {
global.scheme[14]=1;
sCinema(oHellbane,"dialog","You... Recognize her, don't you Barkley?",1);
sCinema(oBarkley,"dialog","Teresa, the patron saint of slams and jams... But what's that got to do with me now?",1);
sCinema(oHellbane,"dialog","These truly are dark times we're living in if you've forgotten your former mistress of b-ball, Teresa.",1);
sCinema(oBarkley,"dialog","That shit doesn't matter anymore, there's no place for b-ball in this world. I don't see the glory of slams and jams when I see this statue... I see only broken dreams and hollow memories.",1);
sCinema(oHellbane,"wait",1.2);
sCinema(oHellbane,"dialog","So be it...",1);
} else {
sCinema(oBarkley,"dialog","There's no reason to stand around and gawk at it.",1);
}
