global.dialog=1;
sCinema(oBarkley,"dialog","Bertha:\\The Post-Cyberpocalypse has dealt hard times for just about everyone and you look to be no exception. The least I can do is offer you a place by the fire. Why don't you sit down and rest a while?");
sCinema(oBarkley,"dialog","Rest by the fire?",0,"Yes","No");
sCinema(oBarkley,"code",cine_0004);
