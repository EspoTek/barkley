global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Mike:\\They say the ghost of a Celtic space warlord haunts Cuchulainn's Tomb and his horde of bainshee minions torture anyone who enters. Not that I'm an authority on Cuchulainn or anything. I make a habit of not entering donjons.");
} else {
sCinema(oBarkley,"dialog","Mike:\\I've heard you're going into Cuchulainn's Tomb. I'm not going to tell you not to do it, man, but I think you should know that it tests the limits of even the most ardent donjon enthusiast.");
}
