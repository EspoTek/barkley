if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oCyberdwarf,"dialog","What we're dealing with, Barkley... It could spell disaster if we fail. I've dealt with B.L.O.O.D.M.O.S.E.S. before and I know firsthand that they're serious customers.",1);
sCinema(oBarkley,"dialog","I... I want to thank you for helping me, Cyberdwarf. I don't know if I could have saved Hoopz without you.",1);
sCinema(oCyberdwarf,"dialog","At least he's safe. That's what matters. We've still got to get to the ruins of the old Spalding building. It's a fair distance away, but the first step is heading to the north, and then right at the fork.",1);
sCinema(oBarkley,"dialog","Okay. Let's get going.",1);
} else {
sCinema(oCyberdwarf,"dialog","The Spalding building is to the north and right. Just stick to the path.",1);
sCinema(oBarkley,"dialog","Alright...",1);
}
