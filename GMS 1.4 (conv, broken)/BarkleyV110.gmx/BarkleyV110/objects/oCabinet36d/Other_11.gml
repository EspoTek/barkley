global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oFollower0,"dialog","You have to stop doing this, Barkley. You'll get diabetes or something.",1);
sCinema(oBarkley,"dialog","Give me a minute, there's something in here... Holy shit, Balthios. Look at this thing. It's a gun!",1);
sCinema(oBarkley,"item","F.I.N.A.L. G.U.N.",1);
sCinema(oFollower0,"dialog","Let me see that... it says \"F.I.N.A.L. G.U.N.\" on it. It looks pretty dangerous.",1);
sCinema(oBarkley,"dialog","Yeah, it does. Weren't there people back in Proto Neo New York who were looking for this?",1);
sCinema(oFollower0,"dialog","Yeah, I think so. Maybe we should take it back to them and get a reward.",1);
sCinema(oBarkley,"dialog","Or maybe we should keep it. This thing looks really powerful. I think Hoopz can use it.",1);
sCinema(oFollower0,"dialog","It's your call. I don't really care.",1);
} else {
sCinema(oBarkley,"dialog","What do you think we should do with the F.I.N.A.L. G.U.N.? Should we take it back to those people who were looking for it in Proto Neo New York?",1);
sCinema(oFollower2,"dialog","I don't really care.",1);
sCinema(oFollower3,"dialog","Can we keep it dad? I've never seen a gun this powerful before.",1);
sCinema(oBarkley,"dialog","We'll see Hoopz. I have to make up my mind.",1);
}
