global.dialog=1;
sCinema(oHellbane,"dialog","This tomb belongs to the b-ball allstar Magic Johnson. I was never fortunate enough to see it, Barkley, but the texts state that the two of you had a number of terriffic showdows. I believe the phrase that would have been used in your times was that you \"rocked the house\".",1);
sCinema(oBarkley,"dialog","I can see you're no greenhorn when it comes to pre-21st century b-ball vernacular and colloquialisms.",1);
sCinema(oHellbane,"dialog","I shall... Take that as a compliment.",1);
