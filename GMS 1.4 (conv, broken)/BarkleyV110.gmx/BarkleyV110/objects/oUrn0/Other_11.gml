global.dialog=1;
if (global.scheme[18]=0) {
global.scheme[18]=1;
sCinema(oBarkley,"dialog","What is this statue?",1);
sCinema(oHellbane,"dialog","It is not a statue, Barkley. It is a canopic urn filled with the entrails of one of the pre-historic ballers. The early ballers believed that if they put their internal organs in urns after death, their souls would find rest in the b-ball dimension.",1);
sCinema(oBarkley,"dialog","That's a ridiculous thing to believe...",1);
sCinema(oHellbane,"dialog","You have to remember that the early ballers were primitive peoples that used the gods to explain life and natural phenomenon. For example, one inscription states that the ancient b-ball players believed that thunder was the result of the gods playing basketball in the sky.",1);
sCinema(oBarkley,"dialog","Hmph, I wonder what Clispaeth would say about that...",1);
sCinema(oHellbane,"dialog","I do not know. Many of these ballers were buried before the time of Clispaeth... Let's go.",1);
} else {
sCinema(oHellbane,"dialog","You know-",1);
sCinema(oBarkley,"dialog","Spare me the history lesson, we've gotta move.",1);
}
