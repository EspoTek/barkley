global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oFollower3,"dialog","Wh-what's this?",1);
sCinema(oFollower2,"dialog","This is a statue of the dreaded bainshee, Hoopz, Cuchulainn's legion of undead singing minions. They are considered by many to be the "+"\"ultimate spook\""+".",1);
sCinema(oFollower3,"dialog","I'm not spooked. Not one bit!",1);
sCinema(oFollower2,"dialog","You'll be... heh, "+"\"singing\""+" a different tune when you see one face to face.",1);
sCinema(oFollower3,"dialog","You're buggin', Cyberdwarf.",1);
} else {
sCinema(oFollower3,"dialog","I've seen scarier ghosts and ghasts in vidcons, Cyberdwarf. Is this supposed to scare me?",1);
sCinema(oFollower2,"dialog","The difference between bainshees and the creatures in your vidcons, Hoopz, is that bainshees... are real.",1);
sCinema(oFollower3,"dialog","Hmph, we'll see about that.",1);
}
