global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Hey, there's a note here. Maybe somebody dropped it. Let's take a look at it...",1);
sCinema(oBarkley,"dialog","\"Dear Genies,\\I think we should try to be as racist as possible to the Duergars. If we can, let us try to take away their civil rights, such as: the right to wear gem-encrusted amulets and the right to eat anything but vitamin C.\\Sincerely, \\Muhammed Geniebane, Chief of all Genies Combined\"");
sCinema(oFollower0,"dialog","This certainly is concerning. It looks like a genie might have dropped it. If this is real, it implies the existence of a conspiracy that goes beyond the realm of Square-Enix-Goya.",1);
sCinema(oFollower2,"dialog","I think we'd better get to the bottom of this and find out what's really going on in the Chup Mines.",1);
} else {
sCinema(oBarkley,"dialog","\"Dear Genies,\\I think we should try to be as racist as possible to the Duergars. If we can, let us try to take away their civil rights, such as: the right to wear gem-encrusted amulets and the right to eat anything but vitamin C.\\Sincerely, \\Muhammed Geniebane, Chief of all Genies Combined\"");
}
