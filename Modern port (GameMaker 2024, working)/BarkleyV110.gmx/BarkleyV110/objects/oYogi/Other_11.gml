global.dialog=1;
www=sOvar(oDog,-1);
if (www=-1) {
sCinema(oBarkley,"dialog","Chip:\\See that dog in Nikes over there? I've only seen him talk out of character (OOC) once. He sure loves his bones though. I bet if you got him a really delicious bone he'd talk to you. Maybe he'd even give you those sweet kicks.");
sCinema(oBarkley,"dialog","Those Nikes... I gotta get those Nikes...",1);
} else {
sCinema(oBarkley,"dialog","Chip:\\Wh-whoa. I can't believe you got that guy to talk! I know I've had my body surgically modified to look like Yogi Bear, but seriously, some of us take it way too far.");
}
