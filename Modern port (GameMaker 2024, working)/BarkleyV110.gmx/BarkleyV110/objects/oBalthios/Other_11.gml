global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBalthios,"dialog","You know... I don't think Vinceborg is one of the bad guys. There's a distinct difference between him and Jordan.",1);
sCinema(oBarkley,"dialog","What do you mean, Balthios?",1);
sCinema(oBalthios,"dialog","Jordan is a malicious old bastard who is trying to get you for whatever perverted definition of justice he believes in. He's a son of a bitch and sick person. Vince... He was a good guy.",1);
sCinema(oBarkley,"dialog","He was one of my best friends before the Purge.",1);
sCinema(oBalthios,"dialog","That's right. Even though he's a cyborg programmed to kill us, he's still Vince Carter. I'm sure there's some way we can get him to remember who he is, remember that he's not a robot...",1);
} else {
sCinema(oBalthios,"dialog","There's got to be some way we can reach Vince, get it to him that he's not one of the bad guys...",1);
sCinema(oBarkley,"dialog","Think about it, Balthios.",1);
sCinema(oBalthios,"dialog","Yeah Charles... I will.",1);
}
