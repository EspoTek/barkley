global.dialog=1;
if (sOvar(oAllard,-1)=-1) {
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Guy:\\Man, I know I've seen your face somewhere before...");
sCinema(oBarkley,"dialog","I, uh, don't know about that...",1);
sCinema(oBarkley,"dialog","Guy:\\That's it, Charles Barkley! Man, the doctor did a great job on your operation. Most guys who get the Charles Barkley operation come out looking like Patrick Ewing or something. That looks fantastic.");
sCinema(oBarkley,"dialog","Wait, what? Charles Barkley operation?",1);
sCinema(oBarkley,"dialog","Guy:\\Man, and you're already in character. You're a real inspiration, you know that? Me? I'm here for the Wilt Chamberlain operation. It's always been a dream of mine to dribble a b-ball in the visage of one of the game's greatest. I mean, just everything about the guy was amazing; his dunks, his rebounds, his shots, his passes. I could pretty much go on forever about him. I'm so nervous, my dreams are about to come true.");
sCinema(oBarkley,"dialog","People get surgery to look like... Charles Barkley?",1);
sCinema(oBarkley,"dialog","Guy:\\Yeah, you're not the first. He's got a whole fanbase of guys who've gotten the surgery. Yours is the best I've ever seen though. It looks so real.");
sCinema(oBarkley,"dialog","J...Jesus Christ... I've uh, I've gotta go.",1);
sCinema(oBarkley,"dialog","Okay, later man. Keep it real.");
} else {
sCinema(oBarkley,"dialog","Guy:\\I can't get over how good a job Dr. Allard did on you. I hope he does that well on me.");
}
} else {
sCinema(oBarkley,"dialog","Guy:\\I thought you were cool, man, but you go and beat up the doctor right after he does such a good job on you. Seriously, how ungrateful can you be? Don't even talk to me. Whatever you've got to say, I don't want to hear it.");
}
