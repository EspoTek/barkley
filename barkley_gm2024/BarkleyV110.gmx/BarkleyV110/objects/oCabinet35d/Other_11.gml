global.dialog=1;
if (sOvar(object_index,-1)=1) {
sCinema(oFollower0,"dialog","I still cannot believe this ball is capable of small scale Chaos Dunks. Its power is... magnificent.",1);
} else {
sOvar(object_index,1);
sCinema(oFollower3,"dialog","This computer has its data parameters encrypted with megahurtz. Let me disable it real fast... We're in! There is another report here.",1);
sCinema(oBarkley,"dialog","I knew you could do it, son. What does it say?",1);
sCinema(oFollower0,"dialog","Progress Report : 02/18/2040\\Despite the small-scale Chaos Dunk, the Master says that we must continue working on the prototype. Measures must be taken to make this b-ball safer, weaker. We cannot have another incident like this on our hands. I am considering leaving Spalding forever, cleaning my hands of this. If I had known that I would be playing God when I began working for Spalding, I would have never accepted the job.\\-Cosby");
sCinema(oBarkley,"dialog","D-dear lord. A Chaos Dunk...",1);
sCinema(oFollower0,"dialog","The test subject, he must have... but that's impossible, you are the only man capable of the-",1);
sCinema(oFollower2,"dialog","There is no question in my mind that this ball is entirely capable of countering the Ultimate B-ball now. The question is... are we?",1);
sCinema(oBarkley,"dialog","...I am.",1);
sCinema(oFollower2,"dialog","Good. Then let's get going. Mulling over this b-ball's power will get us nowhere.",1);
}
