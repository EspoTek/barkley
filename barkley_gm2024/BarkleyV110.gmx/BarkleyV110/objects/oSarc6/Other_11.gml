global.dialog=1;
if (global.scheme[13]=0) {
global.scheme[13]=1;
sCinema(oHellbane,"dialog","This is the tomb of Larry Johnson...",1);
sCinema(oBarkley,"dialog","L-Larry... I... I've never seen a man slam like he did. He'd get this look in his eye, this wild look that told you that something was up, and then out of nowhere he'd snatch that ball and slam it like a true mamma jamma. There was so much I could have learned from him...",1);
sCinema(oHellbane,"dialog","There was a lot we all could have learned from him, Barkley, but there's no looking back. We can regret our mistakes for all our lives or we can keep moving forward like he would have wanted.",1);
sCinema(oBarkley,"dialog","You-you're right. We always have to keep moving forward no matter how bad it hurts...",1);
sCinema(oBarkley,"wait",1.5);
sCinema(oBarkley,"dialog","Wait, what's this?",1);
sCinema(oBarkley,"item","BBall Tear",1);
sCinema(oBarkley,"dialog","Thank you Larry... and... Goodbye...",1);
} else {
sCinema(oBarkley,"dialog","Larry... Thank you...",1);
}
