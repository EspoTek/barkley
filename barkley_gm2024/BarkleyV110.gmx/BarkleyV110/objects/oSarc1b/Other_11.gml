global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oFollower0,"dialog","I can only assume that Dekembe's entrails are stored in these canopic urns.",1);
sCinema(oBarkley,"dialog","Yes... After the Purge, Dekembe was mummified according to African b-ball custom. He was such a large man that they needed two urns to hold his entrails.",1);
sCinema(oFollower0,"dialog","You seem to know quite a bit about African b-ball custom, Barkley.",1);
sCinema(oBarkley,"dialog","I'm proud of my heritage, Balthios. It's important to remember where we came from, no matter where we are.",1);
sCinema(oFollower0,"dialog","Wise words, Barkley. Perhaps someday you'll have to teach me a little about African b-ball tradition.",1);
sCinema(oBarkley,"dialog","Yes, perhaps I will.",1);
} else {
sCinema(oFollower2,"dialog","No time to chat, we've got to move.",1);
}
