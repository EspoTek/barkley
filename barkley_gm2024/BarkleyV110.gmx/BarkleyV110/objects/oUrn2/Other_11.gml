global.dialog=1;
if (global.scheme[20]=0) {
global.scheme[20]=1;
sCinema(oBarkley,"dialog","This urn seems to be missing a few pieces.",1);
sCinema(oHellbane,"dialog","That's true, Barkley. Most of the relics in this ancient tomb are destroyed or damaged beyond recognition. It's a shame, there's so much we could have unlocked, so many secrets about the ancient ballers, perhaps even learned a few of the "+"\"Forbidden Dunks\".",1);
sCinema(oBarkley,"dialog","Forbidden dunks? What are they?",1);
sCinema(oHellbane,"dialog","The Forbidden Dunks were moves that were banned over time because of the threat to the stability of the NBA they presented. One such \"Verboten Jam\" was the Hypno Dunk, a slam that could literally lull all onlookers to sleep. You can imagine why these moves were banned from the league.",1);
sCinema(oBarkley,"dialog","The... power. The incredible power... But texts detailing the performance of these moves still exist, right?",1);
sCinema(oHellbane,"dialog","Yes Barkley, but don't get any ideas...",1);
} else {
sCinema(oBarkley,"dialog","We'd better keep moving.",1);
sCinema(oHellbane,"dialog","Agreed.",1);
}
