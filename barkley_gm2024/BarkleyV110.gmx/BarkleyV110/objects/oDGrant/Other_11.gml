global.dialog=1;
if (sOvar(object_index,-1)=-1) { //pay
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Grant Hill:\\Barkley? Charles Barkley? Is that you?");
sCinema(oBarkley,"dialog","Grant Hill? Holy shit, man! How's it been!?",1);
sCinema(oBarkley,"dialog","Grant Hill:\\It's been great, Barkley! I've been playing pickup games from sunrise to sunset and working on my jams like no tomorrow. What are you doing here, man?");
sCinema(oBarkley,"dialog","I found this magic whistle that teleported me here when I blew on it.",1);
sCinema(oBarkley,"dialog","Grant Hill:\\That's amazing, man. Wish it had been that easy for me. Hey, how's Maureen doing? She doing alright?");
sCinema(oBarkley,"dialog","She... she passed on during the Purge. She was at the game...",1);
sCinema(oBarkley,"dialog","Grant Hill:\\Oh... oh I didn't... I'm sorry Charles. I really am.");
sCinema(oBarkley,"dialog","It's not your fault, Grant. We lost a lot of good people in the Purge.",1);
sCinema(oBarkley,"dialog","Grant Hill:\\That's right... Hey, you know there's a dating service here. You might want to check that out, they've got a lot of fine-looking young WNBA ladies looking for a match, Barkley.");
sCinema(oBarkley,"dialog","I... I don't know if I'm ready to start the whole dating thing again yet, Grant.",1);
sCinema(oBarkley,"dialog","Grant Hill:\\Yeah, I understand that. Well hey, you take care of yourself, alright man? Think about that dating service.");
sCinema(oBarkley,"dialog","Alright, I will. You take care of yourself too, Grant. Don't break your back in a pickup, old man.",1);
} else if (sOvar(object_index,-1)=1) { //no pay
sCinema(oBarkley,"dialog","Grant Hill:\\I'm going to hold you to a one-on-one next time you're here, Barkley. Come prepared.");
}
