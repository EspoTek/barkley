if (sOvar(object_index,-1)=1) {
sCinema(oBarkley,"dialog","Is there anything else we really need to see here?",1);
sCinema(oFollower0,"dialog","Not really.",1);
sCinema(oBarkley,"dialog","Didn't think so.",1);
} else {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Progress Report : 01/21/2040\\The near-Jordan levels of b-ball that the test subject is exhibiting are both fascinating and horrifying on a philosophical standpoint. We have in our hands a tool that could bring the game to new heights and harken a new golden era. Conversely, it has the potential destroy society as we know it. Indeed, the parallels between this and the Ultimate B-ball are frightening.\\-Cosby");
sCinema(oFollower3,"dialog","So wait, how come they were making it if they didn't want to?",1);
sCinema(oFollower2,"dialog","I don't think it's that Dr. Cosby didn't want to create this b-ball, Hoopz. He was pondering the philosophical and ethical possibilities presented by it.",1);
sCinema(oFollower3,"dialog","Philosophy, huh? That's never really been my game.",1);
sCinema(oFollower2,"dialog","I see within you the potential to become one of the Post-Cyberpocalypse's greatest philosophers, Hoopz Barkley.",1);
sCinema(oFollower3,"dialog","Hmm, I'll have to think about that...",1);
}
