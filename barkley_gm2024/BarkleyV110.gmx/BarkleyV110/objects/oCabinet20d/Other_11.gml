global.dialog=1;
if (sOvar(object_index,-1)=-1) {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Damnit, another broken computer.",1);
sCinema(oFollower3,"dialog","Dad, wait. It's not broken, it's just that the XG receptors aren't connected to the tekscreen adapter. Here, let me set it up... There! Good as new, try it now, dad.",1);
sCinema(oBarkley,"dialog","H-how'd you do that, Hoopz?",1);
sCinema(oFollower3,"dialog","Easy, dad! Just hookin' up vidcons!",1);
sCinema(oBarkley,"dialog","I'm... I'm proud of you, son. Now let's see what it says. Hmmm...",1);
sCinema(oFollower0,"dialog","Progress Report : 01/08/2040\\Davis' haste has blinded him to the very real dangers presented by manufacted slamicite. The negative b-ball energies emitted by the substance are enormous. Perhaps when we scientists have better studied manufacted slamicite can we put it to a more practical and safe use. Furthermore, I question the ethical use of this ball that, if used in its full potential, can change the entire balance of the game.\\- Cosby");
sCinema(oFollower0,"dialog","This ball... it could have changed everything.",1);
sCinema(oFollower2,"dialog","That's an understatement, Balthios. It is very clear through the progress reports we have been reading that this ball's power rivalled that of the Ultimate B-ball. This ball could have changed the world.",1);
sCinema(oBarkley,"dialog","We won't find it just standing here. Come on. Let's go.",1);
} else {
sCinema(oBarkley,"dialog","Is there anything else on this computer we can use, Hoopz?",1);
sCinema(oFollower3,"dialog","Sorry, dad. The data's been scrambled by a circuit fry. We'll need more megahurtz.",1);
sCinema(oFollower2,"dialog","We don't have time to decipher wingdings, let's go.",1);
}
