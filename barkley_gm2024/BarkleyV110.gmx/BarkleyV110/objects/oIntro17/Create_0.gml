//proto neo ny intro
with (oGhostdad) x=-999;
if (sOvar(oSign1,-1)=1.61) {
alarm[3]=1;
} if (sOvar(oIntro17,-1)=-1) {
alarm[0]=1;
} else if (sOvar(oSign1,-1)=1.3) {
oBarkley.x=96-4;
oBarkley.y=96;
alarm[1]=1;
with (oBalthios) x=-999;
with (oHoopz) x=-999;
with (oCyberdwarf) x=-999;
} else if (sOvar(oSign1,-1)=1.9) {
oBarkley.x=96-4;
oBarkley.y=96;
alarm[2]=1;
with (oBalthios) x=-999;
with (oHoopz) x=-999;
with (oCyberdwarf) x=-999;
} else {
