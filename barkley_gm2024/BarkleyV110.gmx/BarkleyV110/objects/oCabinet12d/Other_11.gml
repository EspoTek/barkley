global.dialog=1;
if (sOvar(object_index,-1)=1) {
sCinema(oBarkley,"dialog","Maybe there are more documents about the prototype in this cabinet.",1);
sCinema(oFollower2,"dialog","No, Barkley. We can't waste the time.",1);
} else {
sOvar(object_index,1);
sCinema(oBarkley,"dialog","Progress Report : 12/30/2039\\The prototype's aerodynamics by far surpass anything else ever witnessed. Our top scientists estimate that in capable hands, the prototype can pass the speed of sound.\\-Davis");
sCinema(oFollower2,"dialog","Dear Clispaeth... the b-ball that they were working on-",1);
sCinema(oFollower0,"dialog","We don't know if it's a basketball, Cyberdwarf. Spalding made a number of balls in their heyday. This could be any number of things. We'll just have to keep going and find out. We're wasting too much time just standing here. We've got to keep going.",1);
sCinema(oBarkley,"dialog","Right.",1);
}
